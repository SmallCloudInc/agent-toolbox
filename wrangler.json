/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-toolbox",
	"main": "./src/worker/index.ts",
	"account_id": "3c445f673c4e1e5dcca897aa7f6c3c30",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "agent-toolbox.smallcloudinc.com", "custom_domain": true }
	],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agent-toolbox-db",
			"database_id": "c0073068-0bc4-4e9d-b850-37f89f0b0733"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "agent-toolbox"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "9ae20284bb974819817fbe1b776c8430"
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"ratelimits": [
		{
			"name": "LOGIN_CODE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "VERIFY_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "CREATE_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "SEND_RATE_LIMITER",
			"namespace_id": "1004",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {
		"INBOX_DOMAIN": "agent-toolbox.smallcloudinc.com"
	},
	"triggers": {
		"crons": ["0 * * * *", "* * * * *"]
	}
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
